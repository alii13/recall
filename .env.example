# Postgres connection string. Needs the pgvector extension.
# Free tier: https://neon.tech - create project, then run in SQL editor:
#   CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql://user:password@your-host.aws.neon.tech/dbname?sslmode=require

# Shared secret for POST /save. Also used as X-Save-Token header in your
# iOS Shortcut. Generate a fresh random one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SAVE_TOKEN=replace-with-random-48-char-hex

# NVIDIA NIM API key. Used for both the summary LLM (Qwen) and the
# embedding model (nv-embedqa-e5-v5). Free tier from:
#   https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here

# Jina Reader API key for the generic URL extractor (Substack, Medium,
# blogs, anything not Reddit/YouTube/Twitter). Free tier from:
#   https://jina.ai/reader
# Optional - leave blank to use Jina's keyless endpoint at lower rate limit.
JINA_API_KEY=jina_your-key-here

# Optional: logging level (debug | info | warn | error). Default info.
LOG_LEVEL=info

# Optional: HTTP port the API listens on. Default 8080.
PORT=8080

# Optional: the recall host the Mac capture script (scripts/recall-capture.sh)
# posts to. Set this to your deployed host. Defaults to http://localhost:$PORT.
RECALL_HOST=https://your-recall-host
